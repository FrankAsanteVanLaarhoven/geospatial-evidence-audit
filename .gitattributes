# Check every text file out with LF on every platform.
* text=auto eol=lf

# Shell launchers must stay LF to run at all.
*.sh text eol=lf

# Assets Git must never rewrite.
*.gif binary
*.png binary
*.glb binary
*.wav binary
*.pbf binary

# ==============================================================================
# GitHub Linguist Classification Overrides for SpatialForge AI Platform
# Ensures TypeScript, Rust, Go, Python, and PostGIS dominate repository statistics
# ==============================================================================

# Exclude all legacy and runtime JavaScript from language breakdown
*.js linguist-detectable=false
*.js linguist-vendored=true
*.mjs linguist-detectable=false
*.mjs linguist-vendored=true
**/*.js linguist-detectable=false
**/*.js linguist-vendored=true
**/*.mjs linguist-detectable=false
**/*.mjs linguist-vendored=true
src/**/*.js linguist-vendored=true
src/**/*.js linguist-detectable=false
server/**/*.js linguist-vendored=true
server/**/*.js linguist-detectable=false
build/**/*.js linguist-vendored=true
build/**/*.js linguist-detectable=false

# 1. Primary Frontend & Full-Stack TypeScript
src/**/*.ts linguist-language=TypeScript linguist-detectable=true
src/**/*.vue linguist-language=TypeScript linguist-detectable=true
server/**/*.ts linguist-language=TypeScript linguist-detectable=true
types/**/*.ts linguist-language=TypeScript linguist-detectable=true

