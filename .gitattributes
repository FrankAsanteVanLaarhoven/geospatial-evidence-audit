services/crypto-enclave/Cargo.toml linguist-language=Rust linguist-detectable=true

# 3. Go Core API Gateway & Stealth OSINT Crawler
services/core-gateway/**/*.go linguist-language=Go linguist-detectable=true
services/stealth-crawler/**/*.go linguist-language=Go linguist-detectable=true

# 4. Python Sovereign Intelligence Engine & Kinematic Spoofing
